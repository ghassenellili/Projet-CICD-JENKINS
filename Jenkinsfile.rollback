pipeline {
    agent any

    options {
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'ROLLBACK_TO',
            defaultValue: '',
            description: 'Version number only (for example 1.0.12), not the full image name'
        )
    }

    environment {
        DOCKER_REPO = 'ghassenellili123/error-budget-calculator'
    }

    stages {
        // Fails here, before production is touched, if the tag does not exist
        stage('Check the image') {
            steps {
                script {
                    if (isUnix()) {
                        sh "docker pull ${DOCKER_REPO}:${params.ROLLBACK_TO}"
                    } else {
                        bat """
                            docker pull ${DOCKER_REPO}:${params.ROLLBACK_TO}
                        """
                    }
                }
            }
        }

        stage('Rollback production') {
            steps {
                input message: "Put ${DOCKER_REPO}:${params.ROLLBACK_TO} back in production?", ok: 'Rollback'
                script {
                    if (isUnix()) {
                        // Jenkins runs in a container: the host is reached through host.docker.internal
                        sh """
                            set -e
                            PROD_URL="http://host.docker.internal:8082"

                            docker rm -f ebc-prod || true
                            docker run -d --name ebc-prod -p 8082:8080 ${DOCKER_REPO}:${params.ROLLBACK_TO}

                            # Wait up to 20 s until /health answers exactly OK
                            READY=0
                            for i in \$(seq 1 20); do
                                if [ "\$(curl -fs "\$PROD_URL/health" || true)" = "OK" ]; then
                                    READY=1
                                    break
                                fi
                                sleep 1
                            done
                            if [ "\$READY" != "1" ]; then
                                echo "Rollback did not answer OK on /health within 20 s"
                                docker logs ebc-prod
                                exit 1
                            fi

                            # Smoke test: any wrong answer fails the stage
                            curl -fs "\$PROD_URL/health" | grep -x OK

                            echo "Rollback OK: \$PROD_URL runs ${DOCKER_REPO}:${params.ROLLBACK_TO}"
                        """
                    } else {
                        // Windows branch: untested. Jenkins runs on the host, so localhost is used
                        bat """
                            docker rm -f ebc-prod
                            exit /b 0
                        """
                        bat """
                            docker run -d --name ebc-prod -p 8082:8080 ${DOCKER_REPO}:${params.ROLLBACK_TO}
                        """
                        powershell '''
                            $ErrorActionPreference = 'Stop'
                            $url = "http://localhost:8082"

                            # Wait up to 20 s until /health answers exactly OK
                            $ready = $false
                            for ($i = 0; $i -lt 20; $i++) {
                                try {
                                    $r = Invoke-WebRequest -UseBasicParsing -Uri "$url/health"
                                    if ($r.Content.Trim() -ceq 'OK') { $ready = $true; break }
                                } catch { }
                                Start-Sleep -Seconds 1
                            }
                            if (-not $ready) { throw "Rollback did not answer OK on /health within 20 s" }

                            # Smoke test: any wrong answer fails the stage
                            $health = (Invoke-WebRequest -UseBasicParsing -Uri "$url/health").Content.Trim()
                            if ($health -cne 'OK') { throw "/health returned '$health' instead of 'OK'" }

                            Write-Host "Rollback OK: $url runs $env:DOCKER_REPO`:$env:ROLLBACK_TO"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
